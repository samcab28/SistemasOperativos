{
  "name": "flatmap-filter",
  "operators": [
    { "id": "flat", "kind": { "type": "flat_map", "field": "tags", "separator": "," } },
    { "id": "filter", "kind": { "type": "filter", "field": "tags", "predicate": { "kind": "equals", "value": "error" } } },
    { "id": "key", "kind": { "type": "key_by", "field": "service" } },
    {
      "id": "win",
      "kind": {
        "type": "window_aggregate",
        "window": { "length_ms": 5000, "slide_ms": null, "checkpoint_interval_ms": 2000 },
        "aggregator": { "type": "count" },
        "key_field": "service",
        "value_field": null
      }
    },
    { "id": "sink", "kind": { "type": "sink_log" } }
  ],
  "edges": [
    { "from": "flat", "to": "filter" },
    { "from": "filter", "to": "key" },
    { "from": "key", "to": "win" },
    { "from": "win", "to": "sink" }
  ],
  "parallelism": 1
}
