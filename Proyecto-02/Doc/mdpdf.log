   DEBUG: 2025-12-03 21:00:17,004:      pdf_renderer.py:  470: printSegment: │  │  • Round-Robin Scheduler (load-aware)                  │ │
   DEBUG: 2025-12-03 21:00:17,006:      pdf_renderer.py:  470: printSegment: │  │  • Fault Detection & Rescheduling                      │ │
   DEBUG: 2025-12-03 21:00:17,007:      pdf_renderer.py:  470: printSegment: │  │  • Event Ingestion Router                              │ │
   DEBUG: 2025-12-03 21:00:17,008:      pdf_renderer.py:  470: printSegment: │  └────────────────────────────────────────────────────────┘ │
   DEBUG: 2025-12-03 21:00:17,009:      pdf_renderer.py:  470: printSegment: └─────────────┬───────────────────────┬───────────────────────┘
   DEBUG: 2025-12-03 21:00:17,011:      pdf_renderer.py:  470: printSegment:               │ Internal API          │ Internal API
   DEBUG: 2025-12-03 21:00:17,012:      pdf_renderer.py:  470: printSegment:     ┌─────────▼─────────┐   ┌─────────▼─────────┐
