   DEBUG: 2025-12-03 21:00:17,970:      pdf_renderer.py:  470: printSegment: : 
   DEBUG: 2025-12-03 21:00:17,971:      pdf_renderer.py:  470: printSegment: count
   DEBUG: 2025-12-03 21:00:17,972:      pdf_renderer.py:  470: printSegment: , 
   DEBUG: 2025-12-03 21:00:17,973:      pdf_renderer.py:  470: printSegment: sum
   DEBUG: 2025-12-03 21:00:17,974:      pdf_renderer.py:  470: printSegment: , o 
   DEBUG: 2025-12-03 21:00:17,975:      pdf_renderer.py:  470: printSegment: average
   DEBUG: 2025-12-03 21:00:17,976:      pdf_renderer.py:  470: printSegment: l
