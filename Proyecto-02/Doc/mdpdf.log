   DEBUG: 2025-12-03 21:00:17,019:      pdf_renderer.py:  470: printSegment:     │ └───────────────┘ │   │ └───────────────┘ │
   DEBUG: 2025-12-03 21:00:17,020:      pdf_renderer.py:  470: printSegment:     │ ┌───────────────┐ │   │ ┌───────────────┐ │
   DEBUG: 2025-12-03 21:00:17,021:      pdf_renderer.py:  470: printSegment:     │ │  Operators    │ │   │ │  Operators    │ │
   DEBUG: 2025-12-03 21:00:17,022:      pdf_renderer.py:  470: printSegment:     │ │ • Map         │ │   │ │ • Filter      │ │
   DEBUG: 2025-12-03 21:00:17,024:      pdf_renderer.py:  470: printSegment:     │ │ • Window      │ │   │ │ • Aggregate   │ │
