   DEBUG: 2025-12-03 21:00:17,985:      pdf_renderer.py:  470: printSegment:  (null para 
   DEBUG: 2025-12-03 21:00:17,987:      pdf_renderer.py:  470: printSegment: count
   DEBUG: 2025-12-03 21:00:17,989:      pdf_renderer.py:  470: printSegment: )
