   DEBUG: 2025-12-03 21:00:17,761:      pdf_renderer.py:  470: printSegment: :
   DEBUG: 2025-12-03 21:00:17,762:      pdf_renderer.py:  470: printSegment: {
   DEBUG: 2025-12-03 21:00:17,763:      pdf_renderer.py:  470: printSegment:   "id": "lowercase",
   DEBUG: 2025-12-03 21:00:17,764:      pdf_renderer.py:  470: printSegment:   "kind": {
   DEBUG: 2025-12-03 21:00:17,765:      pdf_renderer.py:  470: printSegment:     "map": {
   DEBUG: 2025-12-03 21:00:17,767:      pdf_renderer.py:  470: printSegment:       "field": "message",
   DEBUG: 2025-12-03 21:00:17,768:      pdf_renderer.py:  470: printSegment:       "transform": "to_lower"
   DEBUG: 2025-12-03 21:00:17,769:      pdf_renderer.py:  470: printSegment:     }
   DEBUG: 2025-12-03 21:00:17,770:      pdf_renderer.py:  470: printSegment:   }
   DEBUG: 2025-12-03 21:00:17,770:      pdf_renderer.py:  470: printSegment: }
   DEBUG: 2025-12-03 21:00:17,772:      pdf_renderer.py:  470: printSegment: Transformaciones Disponibles
   DEBUG: 2025-12-03 21:00:17,773:      pdf_renderer.py:  470: printSegment: :
   DEBUG: 2025-12-03 21:00:17,774:      pdf_renderer.py:  470: printSegment: l
   DEBUG: 2025-12-03 21:00:17,775:      pdf_renderer.py:  470: printSegment: to_lower
   DEBUG: 2025-12-03 21:00:17,776:      pdf_renderer.py:  470: printSegment: : Convierte a minúsculas
   DEBUG: 2025-12-03 21:00:17,777:      pdf_renderer.py:  470: printSegment: l
   DEBUG: 2025-12-03 21:00:17,778:      pdf_renderer.py:  470: printSegment: to_upper
   DEBUG: 2025-12-03 21:00:17,780:      pdf_renderer.py:  470: printSegment: : Convierte a mayúsculas
   DEBUG: 2025-12-03 21:00:17,781:      pdf_renderer.py:  470: printSegment: l
   DEBUG: 2025-12-03 21:00:17,782:      pdf_renderer.py:  470: printSegment: trim
   DEBUG: 2025-12-03 21:00:17,783:      pdf_renderer.py:  470: printSegment: : Elimina espacios al inicio y final
   DEBUG: 2025-12-03 21:00:17,784:      pdf_renderer.py:  470: printSegment: l
