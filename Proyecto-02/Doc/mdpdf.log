   DEBUG: 2025-12-03 21:00:16,945:      pdf_renderer.py:  470: printSegment: │                          CLIENT (CLI)                        │
   DEBUG: 2025-12-03 21:00:16,947:      pdf_renderer.py:  470: printSegment: │  ┌──────────────┐  ┌──────────────┐  ┌──────────────┐      │
   DEBUG: 2025-12-03 21:00:16,948:      pdf_renderer.py:  470: printSegment: │  │ Submit Topo  │  │   Status     │  │   Ingest     │      │
   DEBUG: 2025-12-03 21:00:16,949:      pdf_renderer.py:  470: printSegment: │  └──────────────┘  └──────────────┘  └──────────────┘      │
   DEBUG: 2025-12-03 21:00:16,965:      pdf_renderer.py:  470: printSegment: └─────────────────────────┬───────────────────────────────────┘
   DEBUG: 2025-12-03 21:00:16,980:      pdf_renderer.py:  470: printSegment:                           │ HTTP/REST API
   DEBUG: 2025-12-03 21:00:16,982:      pdf_renderer.py:  470: printSegment: ┌─────────────────────────▼───────────────────────────────────┐
   DEBUG: 2025-12-03 21:00:16,998:      pdf_renderer.py:  470: printSegment: │                      MASTER (Coordinator)                    │
   DEBUG: 2025-12-03 21:00:16,999:      pdf_renderer.py:  470: printSegment: │  ┌────────────────────────────────────────────────────────┐ │
   DEBUG: 2025-12-03 21:00:17,001:      pdf_renderer.py:  470: printSegment: │  │  • Topology Registry & Persistence                     │ │
