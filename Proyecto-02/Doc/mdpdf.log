   DEBUG: 2025-12-03 21:00:18,076:      pdf_renderer.py:  470: printSegment: make cancel TOPOLOGY_ID=<id>
   DEBUG: 2025-12-03 21:00:18,077:      pdf_renderer.py:  470: printSegment: Opción 2: Usando cargo directamente
   DEBUG: 2025-12-03 21:00:18,079:      pdf_renderer.py:  470: printSegment: # Iniciar master
   DEBUG: 2025-12-03 21:00:18,080:      pdf_renderer.py:  470: printSegment: cargo run --release -p master
   DEBUG: 2025-12-03 21:00:18,081:      pdf_renderer.py:  470: printSegment: # Iniciar worker (otra terminal)
   DEBUG: 2025-12-03 21:00:18,083:      pdf_renderer.py:  470: printSegment: cargo run --release -p worker -- \
   DEBUG: 2025-12-03 21:00:18,084:      pdf_renderer.py:  470: printSegment:   --worker-id worker-1 \
   DEBUG: 2025-12-03 21:00:18,085:      pdf_renderer.py:  470: printSegment:   --bind 127.0.0.1:9001 \
   DEBUG: 2025-12-03 21:00:18,087:      pdf_renderer.py:  470: printSegment:   --master-url http://127.0.0.1:8080 \
   DEBUG: 2025-12-03 21:00:18,088:      pdf_renderer.py:  470: printSegment:   --slots 4 \
   DEBUG: 2025-12-03 21:00:18,089:      pdf_renderer.py:  470: printSegment:   --advertise-url http://127.0.0.1:9001
   DEBUG: 2025-12-03 21:00:18,090:      pdf_renderer.py:  470: printSegment: # Enviar topología
   DEBUG: 2025-12-03 21:00:18,092:      pdf_renderer.py:  470: printSegment: cargo run --release -p client -- \
   DEBUG: 2025-12-03 21:00:18,093:      pdf_renderer.py:  470: printSegment:   --master-url http://127.0.0.1:8080 \
   DEBUG: 2025-12-03 21:00:18,095:      pdf_renderer.py:  470: printSegment:   submit-topology docs/examples/log_topology.json
   DEBUG: 2025-12-03 21:00:18,096:      pdf_renderer.py:  470: printSegment: # Ingerir eventos
   DEBUG: 2025-12-03 21:00:18,098:      pdf_renderer.py:  470: printSegment: cargo run --release -p client -- \
   DEBUG: 2025-12-03 21:00:18,099:      pdf_renderer.py:  470: printSegment:   --master-url http://127.0.0.1:8080 \
   DEBUG: 2025-12-03 21:00:18,101:      pdf_renderer.py:  470: printSegment:   ingest <TOPOLOGY_ID> --file docs/examples/logs.jsonl
