   DEBUG: 2025-12-03 21:00:17,787:      pdf_renderer.py:  470: printSegment: : Añade prefijo (
   DEBUG: 2025-12-03 21:00:17,788:      pdf_renderer.py:  470: printSegment: {"prefix": {"value": "LOG: "}}
   DEBUG: 2025-12-03 21:00:17,789:      pdf_renderer.py:  470: printSegment: )
   DEBUG: 2025-12-03 21:00:17,790:      pdf_renderer.py:  470: printSegment: l
   DEBUG: 2025-12-03 21:00:17,791:      pdf_renderer.py:  470: printSegment: suffix
   DEBUG: 2025-12-03 21:00:17,792:      pdf_renderer.py:  470: printSegment: : Añade sufijo (
