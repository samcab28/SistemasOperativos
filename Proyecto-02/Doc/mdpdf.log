   DEBUG: 2025-12-03 21:00:17,924:      pdf_renderer.py:  470: printSegment: Ventanas temporales con agregaciones.
   DEBUG: 2025-12-03 21:00:17,925:      pdf_renderer.py:  470: printSegment: Configuración
   DEBUG: 2025-12-03 21:00:17,927:      pdf_renderer.py:  470: printSegment: :
   DEBUG: 2025-12-03 21:00:17,936:      pdf_renderer.py:  470: printSegment: {
   DEBUG: 2025-12-03 21:00:17,938:      pdf_renderer.py:  470: printSegment:   "id": "window-agg",
   DEBUG: 2025-12-03 21:00:17,939:      pdf_renderer.py:  470: printSegment:   "kind": {
   DEBUG: 2025-12-03 21:00:17,940:      pdf_renderer.py:  470: printSegment:     "window_aggregate": {
   DEBUG: 2025-12-03 21:00:17,941:      pdf_renderer.py:  470: printSegment:       "window": {
   DEBUG: 2025-12-03 21:00:17,942:      pdf_renderer.py:  470: printSegment:         "length_ms": 60000,
   DEBUG: 2025-12-03 21:00:17,943:      pdf_renderer.py:  470: printSegment:         "slide_ms": 30000,
   DEBUG: 2025-12-03 21:00:17,945:      pdf_renderer.py:  470: printSegment:         "checkpoint_interval_ms": 5000
   DEBUG: 2025-12-03 21:00:17,946:      pdf_renderer.py:  470: printSegment:       },
   DEBUG: 2025-12-03 21:00:17,947:      pdf_renderer.py:  470: printSegment:       "aggregator": "count",
   DEBUG: 2025-12-03 21:00:17,948:      pdf_renderer.py:  470: printSegment:       "key_field": "service",
   DEBUG: 2025-12-03 21:00:17,949:      pdf_renderer.py:  470: printSegment:       "value_field": null
   DEBUG: 2025-12-03 21:00:17,950:      pdf_renderer.py:  470: printSegment:     }
   DEBUG: 2025-12-03 21:00:17,950:      pdf_renderer.py:  470: printSegment:   }
   DEBUG: 2025-12-03 21:00:17,951:      pdf_renderer.py:  470: printSegment: }
   DEBUG: 2025-12-03 21:00:17,952:      pdf_renderer.py:  470: printSegment: Parámetros
   DEBUG: 2025-12-03 21:00:17,953:      pdf_renderer.py:  470: printSegment: :
   DEBUG: 2025-12-03 21:00:17,955:      pdf_renderer.py:  470: printSegment: l
   DEBUG: 2025-12-03 21:00:17,956:      pdf_renderer.py:  470: printSegment: length_ms
   DEBUG: 2025-12-03 21:00:17,958:      pdf_renderer.py:  470: printSegment: : Duración de la ventana en milisegundos
